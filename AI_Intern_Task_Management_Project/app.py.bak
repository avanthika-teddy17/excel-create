SCHEMA = """
CREATE TABLE IF NOT EXISTS interns (
 id INTEGER PRIMARY KEY AUTOINCREMENT,
 intern_code TEXT UNIQUE,
 name TEXT NOT NULL,
 email TEXT NOT NULL,
 task_title TEXT NOT NULL,
 requirements TEXT DEFAULT '',
 task_link_token TEXT UNIQUE,
 explanation_completed INTEGER DEFAULT 0,
 explanation_completed_at TEXT DEFAULT '',
 review_frequency TEXT DEFAULT '2 days',
 next_review_date TEXT DEFAULT '',
 document_filename TEXT DEFAULT '',
 document_text TEXT DEFAULT '',
 missing_requirements TEXT DEFAULT '',
 ai_suggestions TEXT DEFAULT '',
 feedback TEXT DEFAULT '',
 meeting_link TEXT DEFAULT '',
 status TEXT DEFAULT 'Not Started',
 last_email_sent TEXT DEFAULT '',
 created_at TEXT DEFAULT ''
);
CREATE TABLE IF NOT EXISTS review_history (
 id INTEGER PRIMARY KEY AUTOINCREMENT,
 intern_id INTEGER,
 review_date TEXT,
 review_type TEXT,
 notes TEXT,
 FOREIGN KEY(intern_id) REFERENCES interns(id)
);
"""

def db():
    conn = sqlite3.connect(DATABASE)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    with db() as conn:
        conn.executescript(SCHEMA)

def now_iso():
    return datetime.now().strftime("%Y-%m-%d %H:%M")

def parse_date(value):
    if not value:
        return None
    for fmt in ("%Y-%m-%d", "%d-%m-%Y", "%d/%m/%Y"):
        try:
            return datetime.strptime(str(value).strip()[:10], fmt).date()
        except ValueError:
            pass
    return None

def review_days(frequency):
    return 7 if str(frequency).strip().lower() in ("1 week", "one week", "weekly", "7 days") else 2

def get_intern(intern_id):
    with db() as conn:
        return conn.execute("SELECT * FROM interns WHERE id=?", (intern_id,)).fetchone()

def get_by_token(token):
    with db() as conn:
        return conn.execute("SELECT * FROM interns WHERE task_link_token=?", (token,)).fetchone()

def allowed_file(filename):
    return "." in filename and filename.rsplit(".", 1)[1].lower() in ALLOWED_EXTENSIONS

def send_email(to_email, subject, body):
    if not SMTP_EMAIL or not SMTP_APP_PASSWORD:
        return False, "Email is not configured. Add SMTP_EMAIL and SMTP_APP_PASSWORD at the top of app.py."
    try:
        msg = EmailMessage()
        msg["Subject"] = subject
        msg["From"] = SMTP_EMAIL
        msg["To"] = to_email
        msg.set_content(body)
        with smtplib.SMTP(SMTP_HOST, SMTP_PORT, timeout=20) as server:
            server.starttls()
            server.login(SMTP_EMAIL, SMTP_APP_PASSWORD)
            server.send_message(msg)
        return True, "Email sent."
    except Exception as exc:
        return False, str(exc)

def ask_ai(system_prompt, user_prompt):
    if not AI_API_KEY:
        return None, "AI is not configured. Add AI_API_KEY at the top of app.py."
    try:
        response = requests.post(
            AI_BASE_URL.rstrip("/") + "/chat/completions",
            headers={"Authorization": f"Bearer {AI_API_KEY}", "Content-Type": "application/json"},
            json={
                "model": AI_MODEL,
                "temperature": 0.3,
                "messages": [
                    {"role": "system", "content": system_prompt},
                    {"role": "user", "content": user_prompt},
                ],
            },
            timeout=90,
        )
        response.raise_for_status()
        data = response.json()
        return data["choices"][0]["message"]["content"].strip(), None
    except Exception as exc:
        return None, f"AI request failed: {exc}"

def extract_text(path):
    ext = path.rsplit(".", 1)[-1].lower()
    try:
        if ext in ("txt", "md"):
            with open(path, "r", encoding="utf-8", errors="ignore") as f:
                return f.read()
        if ext == "docx":
            from docx import Document
            doc = Document(path)
            return "\n".join(p.text for p in doc.paragraphs)
        if ext == "pdf":
            from pypdf import PdfReader
            reader = PdfReader(path)
            return "\n".join(page.extract_text() or "" for page in reader.pages)
    except Exception as exc:
        return f"[Could not extract document text: {exc}]"
    return ""

def add_history(intern_id, review_type, notes):
    with db() as conn:
        conn.execute(
            "INSERT INTO review_history (intern_id, review_date, review_type, notes) VALUES (?, ?, ?, ?)",
            (intern_id, now_iso(), review_type, notes),
        )

def make_token():
    return uuid.uuid4().hex

def send_task_email(row, public_base_url=None):
    if public_base_url is None:
        public_base_url = request.url_root.rstrip("/") if request else "http://127.0.0.1:5000"
    link = f"{public_base_url}/task/{row['task_link_token']}"
    subject = f"Your assigned task: {row['task_title']}"
    body = (
        f"Hello {row['name']},\n\n"
        f"You have been assigned a task.\n\nTask: {row['task_title']}\n"
        f"Requirements: {row['requirements'] or 'Please check your task page.'}\n\n"
        f"Open your personal task page: {link}\n\n"
        f"Please use the page to hear the AI voice explanation, submit your document, and check review feedback.\n"
    )
    return send_email(row["email"], subject, body)

def check_due_reminders():
    today = date.today()
    with db() as conn:
        rows = conn.execute(
            "SELECT * FROM interns WHERE status NOT IN ('Completed','Approved') AND next_review_date != ''"
        ).fetchall()
    for row in rows:
        due = parse_date(row["next_review_date"])
        if due and due <= today:
            link = f"http://127.0.0.1:5000/task/{row['task_link_token']}"
            body = (
                f"Hello {row['name']},\n\nThis is your task review reminder.\n"
                f"Task: {row['task_title']}\nReview date: {row['next_review_date']}\n"
                f"Open your task page: {link}\n"
                f"Please submit updates and review the feedback.\n"
            )
            ok, message = send_email(row["email"], f"Reminder: review your task - {row['task_title']}", body)
            if ok:
                next_date = today + timedelta(days=review_days(row["review_frequency"]))
                with db() as conn:
                    conn.execute(
                        "UPDATE interns SET last_email_sent=?, next_review_date=? WHERE id=?",
                        (now_iso(), next_date.isoformat(), row["id"]),
                    )
                add_history(row["id"], "Reminder sent", f"Reminder email sent. Next review: {next_date.isoformat()}")
            else:
                print(f"[Reminder not sent to {row['email']}] {message}")

init_db()
scheduler = BackgroundScheduler(daemon=True)
scheduler.add_job(check_due_reminders, "interval", minutes=CHECK_REMINDERS_EVERY_MINUTES, id="review_reminders", replace_existing=True)
scheduler.start()

def login_required(fn):
    @wraps(fn)
    def wrapper(*args, **kwargs):
        if not request.cookies.get("admin_session") == app.secret_key:
            return redirect(url_for("login", next=request.path))
        return fn(*args, **kwargs)
    return wrapper

