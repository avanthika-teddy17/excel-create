@app.route("/login", methods=["GET", "POST"])
def login():
    if request.method == "POST":
        if request.form.get("username") == ADMIN_USERNAME and request.form.get("password") == ADMIN_PASSWORD:
            response = redirect(url_for("dashboard"))
            response.set_cookie("admin_session", app.secret_key, httponly=True, samesite="Lax")
            return response
        flash("Incorrect username or password.")
    return page("Admin Login", """
    <div class="card" style="max-width:460px;margin:50px auto">
    <h1>Admin Login</h1><p class="small">Default username: admin. Change the password in app.py before using.</p>
    <form method="post"><label>Username</label><input name="username" required><label>Password</label><input type="password" name="password" required><p><button>Sign in</button></p></form></div>
    """)

@app.route("/logout")
def logout():
    response = redirect(url_for("login"))
    response.delete_cookie("admin_session")
    return response

