ADMIN_NOTIFICATION_EMAIL = ""  # optional email for admin notifications

# Review reminders are checked while this app is running.
CHECK_REMINDERS_EVERY_MINUTES = 30
UPLOAD_FOLDER = "uploads"
DATABASE = "intern_tasks.db"
ALLOWED_EXTENSIONS = {"pdf", "docx", "txt", "md"}

app = Flask(__name__)
