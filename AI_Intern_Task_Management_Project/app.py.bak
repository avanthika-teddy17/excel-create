APP_SECRET_KEY = "change-this-to-a-long-random-secret"
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "ChangeMe123!"  # Change before using beyond a local demo

# OpenAI-compatible chat API. Add your API key to enable AI answers/reviews.
