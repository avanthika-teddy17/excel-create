def page(title, content):
    return render_template_string(
        """<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{title}}</title>""" + BASE_STYLE + """</head><body><header><strong>AI Intern Task Management</strong><span><a style="color:white" href="{{ url_for('dashboard') }}">Admin Dashboard</a></span></header><main>
        {% with messages=get_flashed_messages() %}{% for m in messages %}<div class="card">{{m}}</div>{% endfor %}{% endwith %}
        """ + content + """</main></body></html>""",
        title=title,
    )

