    {% for r in rows %}<tr><td>{{r.intern_code or ('INT-' ~ r.id)}}<br><strong>{{r.name}}</strong><br><span class="small">{{r.email}}</span></td><td>{{r.task_title}}<br><span class="small">{{r.requirements[:100]}}</span></td><td>{{r.review_frequency}}<br>{{r.next_review_date}}</td><td><span class="pill">{{r.status}}</span></td><td><a href="{{url_for('intern_task', token=r.task_link_token, _external=True)}}">Open task page</a><br><button class="secondary" onclick="navigator.clipboard.writeText('{{url_for('intern_task', token=r.task_link_token, _external=True)}}')">Copy link</button></td><td><a href="{{url_for('edit_intern', intern_id=r.id)}}">Edit</a><br><a href="{{url_for('send_initial_email', intern_id=r.id)}}">Send task email</a><br><a href="{{url_for('history', intern_id=r.id)}}">History</a></td></tr>{% endfor %}
